Algoritmo "EXERCICIO 4"

Var
valor1, valor2, resultado : real


Inicio
escreva ("Qual o primeiro valor? ")
leia (valor1)
escreva ("Qual o segundo valor? ")
leia (valor2)
se valor2 = 0 entao
escreva ("Segundo valor não pode ser igual a 0, fale outro valor: ")
leia (valor2)
fimse
resultado <- valor1 / valor2
escreval ("O primeiro valor dividido pelo segundo valor é: ",resultado)
Fimalgoritmo